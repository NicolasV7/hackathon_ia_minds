# ============================================================================
#  Frontend Environment Variables (Vite)
# ============================================================================
#  These are BUILD-TIME variables - they get baked into the JS bundle.
#  Changes require rebuilding: npm run build
# ============================================================================

# Backend API URL
# For local development: set to your backend URL
# For Docker production: leave empty (nginx proxies /api/ to backend)
VITE_API_URL=http://localhost:8000

# Environment identifier
VITE_NODE_ENV=development

# Debug mode (logs API calls to browser console)
VITE_DEBUG=true
