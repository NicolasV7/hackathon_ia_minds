# ============================================================================
#  UPTC EcoEnergy - Git Ignore
# ============================================================================

# Environment files (may contain secrets)
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/

# Node
node_modules/
dist/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
*.log

# Agent skills & IDE config (local tooling)
.agents/
.opencode/
skills/

# Keep these dot files tracked
!.gitignore
!.dockerignore
!.env.example
