# ============================================================================
#  UPTC EcoEnergy - Environment Configuration
# ============================================================================
#  This file is OPTIONAL. The app works out of the box without any .env file:
#    docker compose up -d --build
#
#  To customize, copy this file and edit the values you need:
#    cp .env.example .env
#
#  ALL variables below are optional and have sensible defaults.
# ============================================================================

# ----------------------------------------------------------------------------
#  Backend (FastAPI)
# ----------------------------------------------------------------------------

# Database connection string [OPTIONAL]
# Default uses SQLite (recommended for development and single-server deploys)
# For PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///app/data/uptc_energy.db

# Debug mode [OPTIONAL]
# Enables: auto DB init, Swagger docs at /docs, verbose logging
# Set to False in production
DEBUG=true

# CORS allowed origins [OPTIONAL]
# Comma-separated list of allowed frontend origins
# In Docker: the frontend proxies via nginx, so this is mainly for local dev
CORS_ORIGINS_STR=http://localhost:3000,http://localhost:8080,http://localhost:5173

# OpenAI API Key [OPTIONAL]
# Required for AI-powered features: chatbot (/api/v1/chat) and
# AI recommendations (/api/v1/recommendations/ai-generate)
# Without this key, the app still works but AI features return fallback responses
OPENAI_API_KEY=

# OpenAI Model [OPTIONAL]
# Which model to use for chat and recommendations (e.g., gpt-4o-mini, gpt-4o, gpt-3.5-turbo)
OPENAI_MODEL=gpt-3.5-turbo

# ML Models path [OPTIONAL]
# Path inside the container where trained model files (.pkl) are stored
# Default: /app/models (mapped automatically in Docker)
# ML_MODELS_PATH=/app/models

# Database pool settings [OPTIONAL]
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_ECHO=false

# Pagination defaults [OPTIONAL]
# DEFAULT_PAGE_SIZE=50
# MAX_PAGE_SIZE=1000

# ----------------------------------------------------------------------------
#  Frontend (React + Vite)
# ----------------------------------------------------------------------------

# Backend API URL [OPTIONAL]
# Used at BUILD TIME by Vite to set the API base URL in the frontend bundle.
#
# For Docker deployment: leave empty or unset.
#   -> nginx proxies /api/ requests to the backend container automatically.
#
# For local development (npm run dev): set to your backend URL
#   -> e.g., http://localhost:8000
VITE_API_URL=

# ----------------------------------------------------------------------------
#  Telegram Bot
# ----------------------------------------------------------------------------

# Telegram Bot Token [OPTIONAL]
# Get yours from @BotFather on Telegram: https://t.me/BotFather
# If not set, the bot container stays idle until a token is provided
TELEGRAM_BOT_TOKEN=

# Backend API URL for the bot [OPTIONAL]
# In Docker Compose this is auto-configured to http://backend:8000/api/v1
# Only change if running the bot outside Docker
# API_BASE_URL=http://backend:8000/api/v1
